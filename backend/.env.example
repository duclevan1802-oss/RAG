# Mẫu cấu hình backend. Sao chép sang .env và điền thông tin kết nối của bạn.

MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"

MONGODB_DATABASE=rag_local

# Khóa Groq dùng phía backend. GROQ_MODEL chọn model để tạo câu trả lời.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Các địa chỉ frontend được phép gọi API từ trình duyệt.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
